rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidSurvey(data) {
      return data.keys().hasAll(['userId', 'name', 'networkType', 'createdAt']) &&
        data.userId is string &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.networkType is string && data.networkType.size() > 0 && data.networkType.size() <= 20 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        (!('operator' in data) || (data.operator is string && data.operator.size() <= 50)) &&
        (!('avgRsrp' in data) || data.avgRsrp is number) &&
        (!('avgSinr' in data) || data.avgSinr is number) &&
        (!('pci' in data) || data.pci is number) &&
        (!('band' in data) || (data.band is string && data.band.size() <= 30)) &&
        (!('pointCount' in data) || data.pointCount is number) &&
        (!('status' in data) || (data.status is string && data.status.size() <= 20)) &&
        (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidDiagnostic(data) {
      return data.keys().hasAll(['userId', 'targetServer', 'latencyMs', 'downloadSpeedMbps', 'createdAt']) &&
        data.userId is string &&
        data.targetServer is string && data.targetServer.size() > 0 && data.targetServer.size() <= 100 &&
        data.latencyMs is number &&
        data.downloadSpeedMbps is number &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        (!('jitterMs' in data) || data.jitterMs is number) &&
        (!('packetLossPercent' in data) || data.packetLossPercent is number) &&
        (!('rfVerdict' in data) || (data.rfVerdict is string && data.rfVerdict.size() <= 50));
    }

    match /surveys/{surveyId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) && isValidSurvey(request.resource.data);
      allow update: if isOwner(resource.data.userId) &&
                       isOwner(request.resource.data.userId) &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       isValidSurvey(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
    }

    match /diagnostics/{diagnosticId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId) && isValidDiagnostic(request.resource.data);
      allow update: if isOwner(resource.data.userId) &&
                       isOwner(request.resource.data.userId) &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       isValidDiagnostic(request.resource.data);
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
